    "@vitest/coverage-v8": "catalog:",
    "axios": "catalog:",
    "es-toolkit": "catalog:",
    "jsdom": "catalog:",
    "msw": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "recharts": "catalog:",
    "sync-fetch": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
