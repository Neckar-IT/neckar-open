{
  "name": "@neckar-hub/typescript-react-auth",
  "version": "0.0.0",
  "private": true,
  "description": "Frontend Authentication Library for React Applications",
  "author": {
    "name": "Neckar IT GmbH",
    "email": "info@neckar.IT"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./test-support": {
      "types": "./dist/src/testSupport.d.ts",
      "import": "./dist/src/testSupport.js"
    },
    "./tailwind-sources.css": "./src/tailwind-sources.css"
  },
  "scripts": {
    "build": "pnpm run build:deps && pnpm run build:noDeps",
    "build:noDeps": "pnpm run lint:check && pnpm run bundle && pnpm run test:unit",
    "build:deps": "pnpm --recursive --filter \"${npm_package_name}^...\" run --if-present build:noDeps",
    "bundle": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm run lint:check",
    "lint:check": "oxlint --type-aware --type-check --report-unused-disable-directives-severity=error --disable-nested-config .",
    "lint:fix": "oxlint --fix --type-aware --type-check --report-unused-disable-directives-severity=error --disable-nested-config .",
    "lint:report": "oxlint -f gitlab --type-aware --type-check --report-unused-disable-directives-severity=error --disable-nested-config .",
    "test": "pnpm run typecheck && pnpm run test:unit",
    "test:unit": "vitest run",
    "test:watch": "vitest watch",
    "integration-test": "playwright install chromium && playwright test",
    "storybook": "storybook dev --no-open --host 127.0.0.1",
    "storybook:build": "storybook build --output-dir build/storybook",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "@hookform/resolvers": "catalog:",
    "@neckar-hub/typescript-otel-tracing": "workspace:*",
    "@neckar-hub/typescript-react-error-handling": "workspace:*",
    "@neckar-hub/typescript-react-i18n": "workspace:*",
    "@neckar-hub/typescript-react-query": "workspace:*",
    "@neckar-hub/typescript-react-ui": "workspace:*",
    "@neckar-hub/typescript-react-utils": "workspace:*",
    "@neckar-hub/typescript-utils": "workspace:*",
    "axios": "catalog:",
    "cn": "catalog:",
    "keycloak-js": "catalog:",
    "lucide-react": "catalog:",
    "react-hook-form": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@neckar-hub/oxfmt-config": "workspace:*",
    "@neckar-hub/oxlint-config": "workspace:*",
    "@neckar-hub/playwright-config": "workspace:*",
    "@neckar-hub/tailwind-config": "workspace:*",
    "@neckar-hub/typescript-config": "workspace:*",
    "@neckar-hub/vite-config": "workspace:*",
    "@playwright/test": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "es-toolkit": "catalog:",
    "jsdom": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "storybook": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
